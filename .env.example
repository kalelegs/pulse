# Required. Used server-side in actions/getEphemeralToken.ts to mint the short-lived
# realtime client secret; never sent to the browser.
OPENAI_API_KEY=sk-your-openai-api-key

# Optional. Unlocks fundamentals (market cap, P/E, EPS, dividend yield, beta), analyst
# ratings and news headlines on the stock cards. Free tier at https://finnhub.io.
# Without it, quotes, ranges and price history still work from Yahoo Finance.
FINNHUB_API_KEY=your-finnhub-api-key
